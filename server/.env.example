# Core
FLASK_APP=wsgi.py
FLASK_ENV=development
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too

# Database
DATABASE_URL=postgresql://chamaledger:chamaledger@localhost:5432/chamaledger_dev
# For a Tier-3 SACCO tenant with its own schema, TENANT_DB_URL is resolved at runtime, not here.

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# M-Pesa Daraja
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_ENV=sandbox
DARAJA_CALLBACK_BASE_URL=https://your-domain.example.com

# IPRS
IPRS_API_URL=
IPRS_API_KEY=

# Africa's Talking
AT_USERNAME=sandbox
AT_API_KEY=

# CORS
FRONTEND_ORIGIN=http://localhost:5173